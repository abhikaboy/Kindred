{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "jsx": "react",
        "strict": false,
        // ../shared is outside this root, so its bare imports need pointing back here.
        "paths": {
            "@/*": ["./*"],
            "@shared/*": ["../shared/*"],
            "chrono-node": ["./node_modules/chrono-node"]
        },
        "baseUrl": "."
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
